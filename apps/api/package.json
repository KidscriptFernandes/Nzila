{
  "name": "@nzila/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:extras": "tsx src/db/apply-sql.ts extras",
    "db:rls": "tsx src/db/apply-sql.ts rls",
    "db:supabase": "tsx src/db/apply-sql.ts supabase",
    "db:setup": "pnpm db:migrate && pnpm db:extras && pnpm db:supabase && pnpm db:rls",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@fastify/compress": "^9.3.0",
    "@fastify/cors": "^11.4.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/sensible": "^6.0.8",
    "@fastify/swagger": "^9.9.4",
    "@fastify/swagger-ui": "^6.1.4",
    "@fastify/under-pressure": "^9.2.1",
    "@nzila/shared": "workspace:*",
    "@supabase/supabase-js": "^2.119.0",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.17",
    "pino": "^10.4.0",
    "postgres": "^4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nzila/config": "workspace:*",
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
