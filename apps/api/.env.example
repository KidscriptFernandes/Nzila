NODE_ENV=development
PORT=3333
HOST=0.0.0.0
LOG_LEVEL=debug

# Supabase Postgres (pooler, transaction mode)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Supabase
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
# Opcional: usar JWKS assimétrico em vez do segredo HS256
SUPABASE_JWKS_URL=

# Origens do backoffice (separadas por vírgula). Vazio = sem CORS.
CORS_ORIGINS=http://localhost:3000

# Rate limit distribuído (recomendado em produção)
REDIS_URL=
RATE_LIMIT_MAX=100

# WhatsApp Cloud API (fase 3)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Seed do administrador (pnpm db:auth)
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_NAME=
ADMIN_SEED_WHATSAPP=

# Observabilidade
SENTRY_DSN=
