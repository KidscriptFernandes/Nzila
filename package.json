{
  "name": "nzila",
  "version": "0.1.0",
  "private": true,
  "description": "Nzila Concierge — Chegue seguro. Saia explorando.",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,css}\"",
    "db:generate": "pnpm --filter @nzila/api db:generate",
    "db:migrate": "pnpm --filter @nzila/api db:migrate",
    "db:seed": "pnpm --filter @nzila/api db:seed"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.11.11",
    "typescript": "^5.9.3"
  }
}
